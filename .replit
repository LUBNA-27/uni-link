run = "bash scripts/replit_run.sh"

[[ports]]
localPort = 8000
externalPort = 80

[deployment]
build = ["sh", "-c", "python -m pip install -r requirements.txt && cd frontend && npm ci --include=dev && npm run build"]
run = ["sh", "-c", "python -m uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
deploymentTarget = "gce"
